{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_console:stereo_display@1.0.0",
  "title": "dVRK stereo display configuration",
  "type": "object",
  "additionalProperties": false,
  "not": { "required": ["display_horizontal_offset_px", "widget_horizontal_disparity_px"] },
  "required": ["type", "eye_size"],
  "properties": {
    "type": { "const": "dvrk_console:stereo_display@1.0.0" },
    "name": { "type": "string", "minLength": 1, "default": "dvrk_display" },
    "dvrk_console_namespace": { "type": "string", "minLength": 1, "default": "console" },
    "overlay_alpha": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
    "preserve_size": { "type": "boolean", "default": true },
    "display_horizontal_offset_px": { "type": "integer", "deprecated": true, "description": "Legacy widget offset; use widget_horizontal_disparity_px with the opposite sign." },
    "display_horizontal_shift_px": { "type": "integer", "default": 0, "description": "Additional signed disparity of the stereo video in final per-eye output pixels. Positive shifts left-eye pixels right and right-eye pixels left." },
    "widget_horizontal_disparity_px": { "type": "integer", "default": 0, "description": "Signed disparity of fixed per-eye widgets in final per-eye output pixels. Positive appears nearer; zero is the display plane." },
    "gst_input": { "$ref": "#/$defs/gstInput", "description": "Defaults to @dvrk:stereo_alignment:stereo when omitted." },
    "gst_output": { "$ref": "#/$defs/gstOutput" },
    "eye_size": {
      "description": "Use 'auto' to derive each eye from the negotiated side-by-side input caps at startup, or specify a fixed per-eye size.",
      "oneOf": [{ "const": "auto" }, { "$ref": "#/$defs/size" }]
    },
    "sinks": {
      "type": "array",
      "items": { "enum": ["side_by_side", "separate", "headless", "glimage", "glimages"] },
      "default": []
    },
    "pip_gst_inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monos": {
          "type": "array",
          "items": { "$ref": "#/$defs/inputEndpoint" },
          "default": []
        },
        "stereos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": { "$ref": "#/$defs/inputEndpoint" },
              "right": { "$ref": "#/$defs/inputEndpoint" }
            }
          },
          "default": []
        },
        "scale": { "type": "number", "minimum": 0.01, "maximum": 0.99, "default": 0.3 }
      }
    },
    "ar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "left": { "$ref": "#/$defs/inputEndpoint" },
        "right": { "$ref": "#/$defs/inputEndpoint" },
        "color_key": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        },
        "stereo": { "$ref": "#/$defs/inputEndpoint", "description": "Side-by-side RGBA annotation stream mixed over the final stereo frame; defaults to @dvrk:control_panel:annotations when AR is enabled without another input." }
      }
    }
  },
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "gstInput": {
      "type": "string", "minLength": 1,
      "description": "Plain GStreamer pipeline or canonical @dvrk:role:name socket reference."
    },
    "gstOutput": {
      "type": "string",
      "anyOf": [
        { "const": "" },
        { "pattern": "^@dvrk:[^:]+:[^:]+$" }
      ],
      "description": "Canonical dVRK abstract socket reference."
    },
    "inputEndpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["gst_input"],
      "properties": { "gst_input": { "$ref": "#/$defs/gstInput" } }
    }
  }
}
