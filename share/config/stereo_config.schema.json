{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dvrk_console:stereo_display@1.0.0",
  "title": "dVRK stereo display configuration",
  "description": "Configuration consumed by the dvrk_console stereo_display executable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type"],
  "properties": {
    "type": {
      "const": "dvrk_console:stereo_display@1.0.0"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "default": "dvrk_display"
    },
    "dvrk_console_namespace": {
      "type": "string",
      "minLength": 1,
      "default": "console",
      "description": "ROS namespace used for console, teleoperation, and arm status subscriptions."
    },
    "overlay_alpha": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0,
      "default": 0.7
    },
    "preserve_size": {
      "type": "boolean",
      "default": true,
      "description": "Retained for compatibility with the shared stereo configuration parser."
    },
    "display_horizontal_offset_px": {
      "type": "integer",
      "default": 0,
      "description": "Per-eye horizontal display calibration offset written by stereo_display_calibration."
    },
    "stereo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "socket": {
          "$ref": "#/$defs/socketName",
          "description": "Aligned side-by-side stereo socket. Overrides stream when both are present."
        },
        "stream": {
          "type": "string",
          "minLength": 1,
          "description": "GStreamer source fragment producing a side-by-side stereo frame."
        },
        "eye_size": {
          "$ref": "#/$defs/size",
          "description": "Width and height of one eye in the side-by-side stream."
        },
        "size": {
          "$ref": "#/$defs/size",
          "description": "Legacy total stereo size. The parser divides width by two to obtain eye width."
        }
      },
      "allOf": [
        {
          "anyOf": [
            { "required": ["eye_size"] },
            { "required": ["size"] }
          ]
        }
      ]
    },
    "sinks": {
      "type": "array",
      "items": {
        "enum": ["glimage", "glimages"]
      },
      "default": []
    },
    "unixfdsources": {
      "type": "array",
      "items": { "$ref": "#/$defs/socketEntry" },
      "minItems": 1,
      "description": "Legacy/explicit alternative to stereo.socket. The first entry is used as the aligned stereo input."
    },
    "unixfdsinks": {
      "type": "array",
      "items": { "$ref": "#/$defs/socketEntry" },
      "default": [],
      "description": "Local outputs. Only sockets whose short name is stereo or overlay are connected."
    },
    "extra_streams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "monos": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "stereos": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["left", "right"],
            "properties": {
              "left": { "type": "string", "minLength": 1 },
              "right": { "type": "string", "minLength": 1 }
            }
          },
          "default": []
        },
        "scale": {
          "type": "number",
          "minimum": 0.01,
          "maximum": 0.99,
          "default": 0.3
        }
      }
    },
    "ar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "left": { "$ref": "#/$defs/socketName" },
        "right": { "$ref": "#/$defs/socketName" },
        "color_key": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "integer", "minimum": 0, "maximum": 255 }
        }
      }
    }
  },
  "required": ["stereo"],
  "anyOf": [
    {
      "properties": {
        "stereo": { "required": ["socket"] }
      }
    },
    {
      "properties": {
        "stereo": { "required": ["stream"] }
      }
    },
    { "required": ["unixfdsources"] }
  ],
  "$defs": {
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "socketName": {
      "type": "string",
      "minLength": 1,
      "description": "Socket in short-name, role:name, or @dvrk_gst:role:name form."
    },
    "socketEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["socket"],
      "properties": {
        "socket": { "$ref": "#/$defs/socketName" }
      }
    }
  }
}
