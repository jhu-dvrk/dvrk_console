{
  "type": "dvrk_console:stereo_display@1.0.0",
  "name": "test_extra_streams",
  "dvrk_console_namespace": "console",
  "stereo": {
    "stream": "videotestsrc pattern=snow is-live=true ! video/x-raw,width=1280,height=480,framerate=30/1",
    "eye_size": {"width": 640, "height": 480}
  },
  "sinks": ["glimage"],
  "extra_streams": {
    "monos": [
      "videotestsrc pattern=ball is-live=true ! video/x-raw,width=320,height=240,framerate=30/1"
    ],
    "stereos": [
      {
        "left": "videotestsrc pattern=smpte is-live=true ! video/x-raw,width=320,height=240,framerate=30/1",
        "right": "videotestsrc pattern=colors is-live=true ! video/x-raw,width=320,height=240,framerate=30/1"
      }
    ],
    "scale": 0.3
  }
}
