#!/usr/bin/env python3
"""Interactive calibration tool for the dvrk_console stereo display offset.

This tool previews the live stereo feed from a ``@dvrk_gst`` abstract socket
(produced by ``stereo_alignment``) and lets the operator interactively adjust
the ``display_horizontal_offset_px`` value that controls how far apart the two
eye windows are shifted on the surgeon's console display.

Run ``stereo_alignment_calibration`` (from ``dvrk_data``) first to calibrate
camera crop, alignment shifts, and color correction.  Then run this tool to
calibrate the display offset that positions the stereo image at the surgeon's
working depth.

The config must contain a ``stereo.socket`` field pointing to the
``stereo_alignment`` output socket, e.g.::

    "stereo": {
        "socket": "stereo_alignment:stereo",
        "eye_size": {"width": 1920, "height": 1080}
    }
"""

import argparse
import json
import re
import select
from pathlib import Path
import sys
import termios
import tty

import cv2
import numpy as np

from dvrk_data import dvrk_gst_socket as dvrk_gst

KEY_QUIT = "q"
KEY_FULLSCREEN = "f"
KEY_OFFSET_DEC = "LEFT"
KEY_OFFSET_INC = "RIGHT"
KEY_GRID_TOGGLE = "g"


class TerminalInput:
    def __init__(self):
        self.old_settings = termios.tcgetattr(sys.stdin)

    def __enter__(self):
        tty.setcbreak(sys.stdin.fileno())
        return self

    def __exit__(self, exc_type, exc_value, traceback):
        termios.tcsetattr(sys.stdin, termios.TCSADRAIN, self.old_settings)

    def get_key(self):
        key = None
        while select.select([sys.stdin], [], [], 0)[0]:
            ch = sys.stdin.read(1)
            if ch == "\x1b":
                rest = sys.stdin.read(2)
                if rest == "[D":
                    key = KEY_OFFSET_DEC
                elif rest == "[C":
                    key = KEY_OFFSET_INC
                continue
            if ch in ("q", "Q"):
                key = KEY_QUIT
            elif ch in ("f", "F"):
                key = KEY_FULLSCREEN
            elif ch in ("g", "G"):
                key = KEY_GRID_TOGGLE
        return key


def as_preview_pipeline(source_snippet: str) -> str:
    snippet = source_snippet.strip()
    if "appsink" in snippet:
        return snippet
    return f"{snippet} ! videoconvert ! appsink drop=true sync=false"


def open_capture(source_snippet: str):
    pipeline = as_preview_pipeline(source_snippet)
    cap = cv2.VideoCapture(pipeline, cv2.CAP_GSTREAMER)
    if not cap.isOpened():
        msg = (
            f"Unable to open stereo source with GStreamer backend.\n"
            f"Pipeline: {pipeline}\n"
        )
        m = re.search(r"socket-path=(\S+)", pipeline)
        socket_path = ("@" + m.group(1)) if m else "<socket>"
        msg += (
            f"\nThe abstract socket {socket_path} could not be opened.\n"
            "Make sure stereo_source and stereo_alignment are running:\n"
            "  ros2 run dvrk_data stereo_source -c <stereo_source.json>\n"
            "  ros2 run dvrk_data stereo_alignment -c <stereo_alignment.json>\n"
            "\nTo list currently active @dvrk_gst sockets:\n"
            "  ros2 run dvrk_data gscam_socket"
        )
        raise RuntimeError(msg)
    return cap


def parse_args():
    parser = argparse.ArgumentParser(
        description=(
            "Interactive dvrk_console stereo display offset calibration tool. "
            "Reads the pre-aligned stereo stream from a stereo.socket and lets "
            "the operator tune display_horizontal_offset_px interactively."
        )
    )
    parser.add_argument("-c", "--config", required=True, help="Path to dvrk_console JSON config")
    parser.add_argument("-s", "--split", action="store_true", help="Split stereo view in two windows")
    return parser.parse_args()


def interactive_display_tune(config, split_mode=False):
    stereo_cfg = config.get("stereo", {})
    stereo_socket_field = stereo_cfg.get("socket", "").strip()
    if not stereo_socket_field:
        raise RuntimeError(
            "stereo.socket is required but not set in the config.\n"
            "Add a 'stereo' section with a 'socket' field, e.g.:\n"
            '  "stereo": {"socket": "stereo_alignment:stereo", '
            '"eye_size": {"width": 1920, "height": 1080}}'
        )

    abstract_name = dvrk_gst.resolve(stereo_socket_field, dvrk_gst.ROLE_STEREO_ALIGNMENT)
    eye_size = stereo_cfg.get("eye_size", config.get("camera", {}).get("size", {}))
    eye_w = int(eye_size.get("width", 0))
    eye_h = int(eye_size.get("height", 0))
    stereo_snippet = dvrk_gst.build_src(abstract_name, eye_w * 2, eye_h)
    print(f"Using stereo socket: {abstract_name}")
    cap = open_capture(stereo_snippet)

    # Probe the first frame to confirm dimensions
    ok, frame = cap.read()
    if not ok or frame is None:
        raise RuntimeError("Unable to read first frame from stereo socket")
    if eye_w <= 0:
        eye_w = frame.shape[1] // 2
    if eye_h <= 0:
        eye_h = frame.shape[0]

    display_horizontal_offset = int(config.get("display_horizontal_offset_px", 0))
    show_grid = True

    window_name = "stereo_preview"
    left_window_name = "left_preview"
    right_window_name = "right_preview"

    if split_mode:
        cv2.namedWindow(left_window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL)
        cv2.resizeWindow(left_window_name, max(640, eye_w), max(360, eye_h))
        cv2.namedWindow(right_window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL)
        cv2.resizeWindow(right_window_name, max(640, eye_w), max(360, eye_h))
    else:
        cv2.namedWindow(window_name, cv2.WINDOW_NORMAL | cv2.WINDOW_KEEPRATIO | cv2.WINDOW_GUI_NORMAL)
        cv2.resizeWindow(window_name, max(960, 2 * eye_w), max(360, eye_h))

    print(f"Eye size: {eye_w}x{eye_h}")
    print("Controls: left/right arrows=display_offset  g=toggle grid  f=fullscreen  q=quit")

    grid_rows = 3
    grid_cols = 4
    grid_colors = [tuple(np.random.randint(0, 256, 3).tolist()) for _ in range(grid_rows * grid_cols)]
    preview_fullscreen = False

    with TerminalInput() as term:
        while True:
            ok, stereo_frame = cap.read()
            if not ok or stereo_frame is None:
                cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
                ok, stereo_frame = cap.read()
            if not ok or stereo_frame is None:
                continue

            left_preview = stereo_frame[:eye_h, :eye_w].copy()
            right_preview = stereo_frame[:eye_h, eye_w:eye_w * 2].copy()

            if left_preview.size == 0 or right_preview.size == 0:
                continue

            if show_grid:
                curr_h, curr_w = left_preview.shape[:2]
                center_x = curr_w // 2
                square_size = int(curr_h * 0.05)
                span_w = int(curr_w * 0.8)
                span_h = int(curr_h * 0.8)
                padding_x = (span_w - grid_cols * square_size) // (grid_cols - 1)
                padding_y = (span_h - grid_rows * square_size) // (grid_rows - 1)
                grid_w = grid_cols * square_size + (grid_cols - 1) * padding_x
                grid_h = grid_rows * square_size + (grid_rows - 1) * padding_y

                for eye_idx, preview_eye in enumerate([left_preview, right_preview]):
                    sign = -1 if eye_idx == 0 else 1
                    cx = int(center_x + sign * display_horizontal_offset / 2.0)
                    start_x = cx - grid_w // 2
                    start_y = curr_h // 2 - grid_h // 2
                    for r in range(grid_rows):
                        for c in range(grid_cols):
                            x = start_x + c * (square_size + padding_x)
                            y = start_y + r * (square_size + padding_y)
                            color = grid_colors[r * grid_cols + c]
                            cv2.rectangle(preview_eye, (x, y), (x + square_size, y + square_size), color, -1)
                for eye_idx, preview_eye in enumerate([left_preview, right_preview]):
                    sign = -1 if eye_idx == 0 else 1
                    cx = int(center_x + sign * display_horizontal_offset / 2.0)
                    cy = curr_h // 2
                    radius = int(curr_h * 0.4)
                    cv2.circle(preview_eye, (cx, cy), radius, (255, 255, 255), 4)

            info = f"display_offset:{display_horizontal_offset}  grid:{'on' if show_grid else 'off'}"
            controls = "arrows:display_offset  g:grid  f:fullscreen  q:quit"

            if split_mode:
                cv2.putText(left_preview, info, (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2, cv2.LINE_AA)
                cv2.putText(left_preview, controls, (10, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1, cv2.LINE_AA)
                cv2.imshow(left_window_name, left_preview)
                cv2.imshow(right_window_name, right_preview)
            else:
                preview = np.hstack([left_preview, right_preview])
                cv2.putText(preview, info, (10, 24), cv2.FONT_HERSHEY_SIMPLEX, 0.55, (0, 255, 0), 2, cv2.LINE_AA)
                cv2.putText(preview, controls, (10, 48), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1, cv2.LINE_AA)
                display = preview
                if preview_fullscreen:
                    try:
                        _, _, win_w, win_h = cv2.getWindowImageRect(window_name)
                        if win_w > 0 and win_h > 0:
                            display = cv2.resize(preview, (win_w, win_h), interpolation=cv2.INTER_LINEAR)
                    except cv2.error:
                        pass
                cv2.imshow(window_name, display)

            cv2.waitKey(1)
            key = term.get_key()

            if key == KEY_QUIT:
                break
            elif key == KEY_FULLSCREEN:
                preview_fullscreen = not preview_fullscreen
                mode = cv2.WINDOW_FULLSCREEN if preview_fullscreen else cv2.WINDOW_NORMAL
                aspect = cv2.WINDOW_FREERATIO if preview_fullscreen else cv2.WINDOW_KEEPRATIO
                if split_mode:
                    for wn in [left_window_name, right_window_name]:
                        cv2.setWindowProperty(wn, cv2.WND_PROP_FULLSCREEN, mode)
                        cv2.setWindowProperty(wn, cv2.WND_PROP_ASPECT_RATIO, aspect)
                else:
                    cv2.setWindowProperty(window_name, cv2.WND_PROP_FULLSCREEN, mode)
                    cv2.setWindowProperty(window_name, cv2.WND_PROP_ASPECT_RATIO, aspect)
            elif key == KEY_OFFSET_DEC:
                display_horizontal_offset -= 2
            elif key == KEY_OFFSET_INC:
                display_horizontal_offset += 2
            elif key == KEY_GRID_TOGGLE:
                show_grid = not show_grid

    cap.release()
    cv2.destroyAllWindows()

    return int(display_horizontal_offset)


def main():
    args = parse_args()
    path = Path(args.config)
    if not path.exists():
        print(f"Error: config file does not exist: {path}")
        return 1

    with path.open("r", encoding="utf-8") as f:
        config = json.load(f)

    try:
        split_mode = args.split or "glimages" in config.get("sinks", [])
        display_horizontal_offset = interactive_display_tune(
            config, split_mode=split_mode
        )
    except RuntimeError as exc:
        print(f"Error: {exc}")
        return 1

    while True:
        decision = input(f"Save display_horizontal_offset_px={display_horizontal_offset} to {path}? [y/N]: ").strip().lower()
        if decision in ("y", "yes"):
            break
        if decision in ("", "n", "no"):
            print("Changes discarded.")
            return 0
        print("Please answer with y/yes or n/no.")

    config["display_horizontal_offset_px"] = display_horizontal_offset

    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as f:
        f.write(json.dumps(config, indent=2) + "\n")

    print(f"Wrote {path}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
